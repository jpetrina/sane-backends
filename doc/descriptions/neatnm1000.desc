; SANE Backend specification file
;
; It's basically emacs-lisp --- so ";" indicates comment to end of line.
; All syntactic elements are keyword tokens, followed by a string or
;  keyword argument, as specified.
;
; ":backend" *must* be specified.
; All other information is optional (but what good is the file without it?).
;

:backend "neatnm1000"		; name of backend
:version "1.0-0 (new)"		; version of backend
:manpage "sane-neatnm1000"	; name of manpage (if it exists)

:devicetype :scanner		; start of a list of devices....
				; other types:  :stillcam, :vidcam,
				;               :meta, :api

:mfg "Neat"			; name of manufacturer

:model "NM-1000 Mobile Scanner"
:interface "USB"
:usbid "0x1f44" "0x0001"
:status :good
:comment "Sheetfed portable CIS. Gray 150/300/600 and color 150/300 dpi. No vendor firmware blob needed; init scripts and calibration data ship with the backend."
